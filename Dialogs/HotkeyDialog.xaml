<Window x:Class="SJHotkeys.Dialogs.HotkeyDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Add Hotkey" Icon="/SJHotkeys;component/Assets/sj-studios-logo-cropped.png" Width="480" MinWidth="420" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI Variable Text, Segoe UI" ShowInTaskbar="False" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,22"><TextBlock x:Name="Heading" Text="Add Hotkey" FontSize="21" FontWeight="Bold"/><TextBlock Text="Choose a program and set a shortcut." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
    <StackPanel Grid.Row="1" Margin="0,0,0,18"><TextBlock Text="PROGRAM" Foreground="{StaticResource Muted}" FontWeight="Bold" FontSize="10" Margin="0,0,0,8"/><Grid MinWidth="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ProgramPathBox" IsReadOnly="True" VerticalContentAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><Button Grid.Column="1" Margin="8,0,0,0" Click="Browse_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconFolder}" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.7" Width="16" Height="16" Stretch="Uniform" Margin="0,0,7,0"/><TextBlock Text="Browse"/></StackPanel></Button></Grid></StackPanel>
    <StackPanel Grid.Row="2" Margin="0,0,0,20"><TextBlock Text="HOTKEY" Foreground="{StaticResource Muted}" FontWeight="Bold" FontSize="10" Margin="0,0,0,8"/><TextBox x:Name="ShortcutBox" Height="43" IsReadOnly="True" Focusable="True" VerticalContentAlignment="Center" FontSize="14" PreviewKeyDown="ShortcutBox_PreviewKeyDown" GotKeyboardFocus="ShortcutBox_GotKeyboardFocus" LostKeyboardFocus="ShortcutBox_LostKeyboardFocus" ToolTip="Click here and press a shortcut"/><TextBlock Text="Use at least one modifier: Ctrl, Alt, Shift or Win." Foreground="{StaticResource Muted}" FontSize="11" Margin="2,7,0,0"/></StackPanel>
    <TextBlock Grid.Row="3" x:Name="ErrorText" Foreground="#FF8686" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/><Button Content="Save Hotkey" Style="{StaticResource AccentButton}" IsDefault="True" Click="Save_Click"/></StackPanel>
  </Grid>
</Window>
