<Window x:Class="SJHotkeys.Dialogs.SettingsDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="About &amp; Settings" Icon="pack://application:,,,/Assets/sj-hotkeys-icon.png" Width="470" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" MaxHeight="760" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI Variable Text, Segoe UI" ShowInTaskbar="False" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid Margin="26" ClipToBounds="True"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid MinWidth="0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="72" Height="60" CornerRadius="12" Background="Transparent" VerticalAlignment="Top" Margin="0,0,16,0"><Image Source="pack://application:,,,/Assets/sj-studios-logo-cropped.png" Stretch="Uniform" SnapsToDevicePixels="True"/></Border><StackPanel Grid.Column="1" MinWidth="0"><TextBlock Text="SJ Hotkeys" FontSize="22" FontWeight="Bold"/><TextBlock Text="by SJ Studios" Foreground="{StaticResource Muted}" Margin="0,3,0,11"/><TextBlock Text="SJ Hotkeys is a lightweight application that lets you launch your favorite programs using custom keyboard shortcuts." Foreground="#C2C5CA" TextWrapping="Wrap" LineHeight="19"/><TextBlock x:Name="VersionText" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Grid>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,0"><Button Click="Source_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconGithub}" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.5" Width="17" Height="17" Stretch="Uniform" Margin="0,0,9,0"/><TextBlock Text="View Source Code"/><Path Data="M7 17 17 7 M7 7h10v10" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" Margin="9,0,0,0"/></StackPanel></Button><Button Margin="10,0,0,0" Click="CheckForUpdates_Click" AutomationProperties.Name="Check for updates">Check for updates</Button></StackPanel>
    <Border Grid.Row="2" Background="#272A30" Height="1" Margin="0,22"/>
    <StackPanel Grid.Row="3"><TextBlock Text="PREFERENCES" Foreground="{StaticResource Muted}" FontWeight="Bold" FontSize="10" Margin="0,0,0,12"/><Border Background="{StaticResource Panel}" CornerRadius="12" Padding="14,3"><StackPanel><CheckBox x:Name="StartWithWindowsBox" Content="Start with Windows" MinHeight="42" Checked="Setting_Changed" Unchecked="Setting_Changed"/><Border Height="1" Background="#292C32"/><CheckBox x:Name="MinimizeToTrayBox" Content="Minimize to Tray" MinHeight="42" Checked="Setting_Changed" Unchecked="Setting_Changed"/><Border Height="1" Background="#292C32"/><CheckBox x:Name="LaunchMinimizedBox" Content="Launch Minimized" MinHeight="42" Checked="Setting_Changed" Unchecked="Setting_Changed"/></StackPanel></Border><TextBlock Text="HOTKEY PROFILE" Foreground="{StaticResource Muted}" FontWeight="Bold" FontSize="10" Margin="0,18,0,9"/><StackPanel Orientation="Horizontal"><Button Content="Export profile" Click="ExportProfile_Click"/><Button Content="Import profile" Margin="9,0,0,0" Click="ImportProfile_Click"/></StackPanel><TextBlock x:Name="UpdateStatusText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="2,10,2,0" Visibility="Collapsed"/><TextBlock x:Name="ErrorText" Foreground="#FF8686" TextWrapping="Wrap" Margin="2,10,2,0" Visibility="Collapsed"/><Grid Margin="0,22,0,0"><TextBlock Text="by SJ Studios" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/><Button Content="Done" Style="{StaticResource AccentButton}" HorizontalAlignment="Right" IsCancel="True"/></Grid></StackPanel>
  </Grid>
</Window>
