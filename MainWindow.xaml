<Window x:Class="SJHotkeys.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SJ Hotkeys" Icon="pack://application:,,,/Assets/sj-hotkeys-icon.png" Width="560" Height="700" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" ResizeMode="NoResize" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style x:Key="TitleBarButton" TargetType="Button"><Setter Property="Width" Value="42"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="surface" Background="{TemplateBinding Background}" CornerRadius="7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Background" Value="{StaticResource PanelHover}"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="surface" Property="Opacity" Value="0.7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <DataTemplate x:Key="HotkeyTemplate">
      <Border Background="{StaticResource Panel}" CornerRadius="13" Padding="16" Margin="0,0,2,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid Grid.Column="0" MinWidth="0" Margin="0,0,12,0" ToolTip="{Binding ProgramPath}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource Text}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <Border Grid.Row="1" Background="#292D33" CornerRadius="7" Padding="9,5" HorizontalAlignment="Left" Margin="0,10,0,0"><TextBlock Text="{Binding ShortcutText}" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold"/></Border>
          </Grid>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Tag="{Binding}" Click="EditHotkey_Click" Margin="0,0,5,0" Padding="9,8" ToolTip="Edit hotkey"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconEdit}" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.7" Width="15" Height="15" Stretch="Uniform" Margin="0,0,6,0"/><TextBlock Text="Edit"/></StackPanel></Button>
            <Button Tag="{Binding}" Click="DeleteHotkey_Click" Style="{StaticResource IconButton}" ToolTip="Delete hotkey" AutomationProperties.Name="Delete hotkey"><Path Data="{StaticResource IconTrash}" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.7" Width="17" Height="17" Stretch="Uniform"/></Button>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Border BorderBrush="#2B2E35" BorderThickness="1" CornerRadius="9" Background="{StaticResource Bg}" ClipToBounds="True">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="TitleBar" Grid.Row="0" Background="{StaticResource Bg}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"><Image Source="pack://application:,,,/Assets/sj-hotkeys-icon.png" Width="18" Height="18" Stretch="Uniform"/><TextBlock Text="SJ Hotkeys" FontSize="12" Foreground="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0">
        <Button Style="{StaticResource TitleBarButton}" Click="Settings_Click" ToolTip="About &amp; settings" AutomationProperties.Name="About and settings"><Path Data="{StaticResource IconSettings}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="19" Height="19" Stretch="Uniform"/></Button>
        <Button Style="{StaticResource TitleBarButton}" Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize"><Path Data="{StaticResource IconWindowMinimize}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="14" Height="14" Stretch="Uniform"/></Button>
        <Button Style="{StaticResource TitleBarButton}" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close"><Path Data="{StaticResource IconWindowClose}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="14" Height="14" Stretch="Uniform"/></Button>
      </StackPanel>
    </Grid>
   <Grid Grid.Row="1" Margin="28,20,28,22" ClipToBounds="True">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid MinWidth="0"><StackPanel><TextBlock Text="SJ Hotkeys" FontSize="25" FontWeight="Bold"/><TextBlock Text="Your shortcuts, one tap away." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></Grid>
    <Button Grid.Row="1" x:Name="AddButton" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Margin="0,24,0,18" Click="AddHotkey_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconPlus}" Stroke="#171A13" StrokeThickness="2" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/><TextBlock Text="Add Hotkey"/></StackPanel></Button>
    <Grid Grid.Row="2" MinWidth="0" ClipToBounds="True"><ListBox x:Name="HotkeyList" ItemTemplate="{StaticResource HotkeyTemplate}"/><StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"><Border Width="52" Height="52" CornerRadius="16" Background="{StaticResource Panel}" Margin="0,0,0,14"><Path Data="{StaticResource IconPlus}" Stroke="{StaticResource Accent}" StrokeThickness="1.8" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="No hotkeys added yet." Foreground="{StaticResource Muted}" FontSize="14"/></StackPanel></Grid>
    <Grid Grid.Row="3" Margin="0,14,0,0"><TextBlock Text="HOTKEYS" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock x:Name="StatusText" Text="Running in background" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
   </Grid>
  </Grid>
 </Border>
</Window>
